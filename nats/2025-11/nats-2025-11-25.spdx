FileName: nats-2025-11-25.zip/nats-server/scripts/updateCopyrights.sh
SPDXID: SPDXRef-item12225716
FileChecksum: SHA1: f3877f0674ea6ec642a8f55fe4c77d82e9bb2771
FileChecksum: SHA256: 7eea853cb453eceb38c3025a5c02d1d2273efd36497bc1e053766c818de1ff95
FileChecksum: MD5: dd900ad7f59114a742ae76afd6a0522d
LicenseConcluded: NOASSERTION
LicenseInfoInFile: NOASSERTION
FileCopyrightText: <text> copyright belonging to "The NATS Authors"
copyright=$(grep -oE "^// Copyright [0-9]{4}(-[0-9]{4})? The NATS Authors" "$file" || echo "") z "$current_copyright" ]] && continue
copyright" last_year=$(git log --follow --format="%ad" --date=format:%Y --grep="(C|c)opyright" --invert-grep -n 1 -- "$file") existing_years=$(echo "$current_copyright" | grep -oE "[0-9]{4}(-[0-9]{4})?")
copyright range if [[ "$existing_years" =~ ^([0-9]{4})-([0-9]{4})$ ]]; then first_year=${BASH_REMATCH[1]}
copyright="// Copyright $first_year-$last_year The NATS Authors" elif [[ "$existing_years" =~ ^([0-9]{4})$ ]]; then first_year=${BASH_REMATCH[1]} if [[ "$first_year" == "$last_year" ]]; then
copyright="// Copyright $first_year The NATS Authors" else
copyright="// Copyright $first_year-$last_year The NATS Authors" fi else continue # If the format is somehow incorrect, skip the file fi
Copyright.*|$new_copyright|" "$file" else BSD/macOS sed, needs -i ''
Copyright.*|$new_copyright|" "$file" fi done </text>

